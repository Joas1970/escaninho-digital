---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Projetos externos abrem em nova aba; projetos com página interna navegam
// normalmente dentro do próprio Escaninho.
const linkProps = project.external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};

// Projeto sem endereço confirmado ainda: o card não vira link, apenas
// comunica o estado atual (nunca usamos "#" como link fictício).
const isAvailable = project.available !== false && Boolean(project.url?.trim()) && project.url?.trim() !== "#";
const buttonLabel = project.buttonLabel ?? "Conhecer o projeto";
---

<article class="project-card">
  <div class="project-card__media">
    {project.image ? (
      <img src={project.image} alt={project.imageAlt ?? `Imagem do projeto ${project.title}`} width="640" height="400" loading="lazy" />
    ) : (
      <div class="project-card__placeholder" aria-hidden="true">Imagem em preparação</div>
    )}
  </div>
  <div class="project-card__body">
    <div class="project-card__meta">
      <p class="project-card__category">{project.category}</p>
      {
        isAvailable && project.external && (
          <span class="external-indicator" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
            </svg>
            Site externo
          </span>
        )
      }
    </div>
    <h3 class="project-card__title">{project.title}</h3>
    <p class="project-card__description">{project.description}</p>
    {
      project.tags && project.tags.length > 0 && (
        <ul class="project-card__tags">
          {project.tags.map((tag) => (
            <li class="project-card__tag">{tag}</li>
          ))}
        </ul>
      )
    }
    {
      isAvailable ? (
        <a href={project.url} class="project-card__link" {...linkProps}>
          {buttonLabel}
          <span class="sr-only">: {project.title}</span>
          <span aria-hidden="true">→</span>
          {isAvailable && project.external && (
            <span class="sr-only"> (abre em uma nova aba, site externo)</span>
          )}
        </a>
      ) : (
        <span class="project-card__status" >
          Em desenvolvimento
        </span>
      )
    }
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg);
    transition: border-color var(--transition);
  }

  .project-card:hover {
    border-color: var(--color-gold-text);
  }

  .project-card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .project-card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
    padding: var(--space-md);
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .project-card__category {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold-text);
    margin: 0;
  }

  .external-indicator {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-card__title {
    font-size: 1.1rem;
    margin: 0;
  }

  .project-card__description {
    color: var(--color-text);
    font-size: 0.95rem;
    margin: 0;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: 0;
  }

  .project-card__tag {
    font-size: 0.72rem;
    color: var(--color-text);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .project-card__link {
    margin-top: auto;
    padding-top: var(--space-xs);
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .project-card__link:hover {
    color: var(--color-gold-text);
  }

  .project-card__status {
    margin-top: auto;
    padding-top: var(--space-xs);
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
</style>
