---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: string;
  imageAlt: string;
}

const { eyebrow, title, text, image, imageAlt } = Astro.props;
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="hero__title">{title}</h1>
      <p class="hero__text">{text}</p>
    </div>
    <div class="hero__media">
      <img src={image} alt={imageAlt} width="760" height="507" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__title {
    font-size: clamp(1.9rem, 3.2vw, 2.75rem);
    max-width: 18ch;
  }

  .hero__text {
    max-width: 42ch;
    color: var(--color-text);
  }

  .hero__media img {
    border-radius: var(--radius);
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__media {
      order: -1;
    }
  }
</style>
