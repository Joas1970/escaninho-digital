---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
---

<BaseLayout
  title="Professor Joas Alves"
  description="Identidade profissional, autoria e trajetória do professor responsável pelos projetos do ecossistema educacional."
  path="/sobre/professor-joas-alves/"
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow="Sobre · Autoria"
        title="Professor Joas Alves"
        text="Professor responsável pela concepção e curadoria do Escaninho Digital e dos demais projetos do ecossistema."
      />
      <div class="content-block">
        <p>
          A identidade profissional, a trajetória e a produção completa do
          professor Joas Alves estão apresentadas em
          <a
            href="https://www.professorjoas.com.br"
            target="_blank"
            rel="noopener noreferrer"
          >
            professorjoas.com.br
            <span class="sr-only"> (abre em uma nova aba, site externo)</span>
          </a>.
        </p>
        <p>
          Aqui no Escaninho Digital, esta página serve apenas como ponto de
          contato entre os projetos do ecossistema e a autoria que os
          conecta.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .content-block {
    max-width: 56ch;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
