---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ResourceGrid from "../../../components/ResourceGrid.astro";
import { getResourcesByCollection, getSourcesByCollection } from "../../../data/resources";

const collectionResources = getResourcesByCollection("filosofia");
const collectionSources = getSourcesByCollection("filosofia");
---

<BaseLayout
  title="Filosofia"
  description="Textos, conceitos e propostas de atividade para introduzir o pensamento filosófico, organizados pelo Escaninho Digital."
  path="/acervo/filosofia/"
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow="Acervo · Filosofia"
        title="Filosofia"
        text="Espaço dedicado a textos, conceitos e propostas de atividade para introduzir e aprofundar o pensamento filosófico em sala de aula."
      />
      <section aria-labelledby="collection-resources-title">
        <h2 id="collection-resources-title">Recursos</h2>
        <ResourceGrid resources={collectionResources} />
      </section>
      {collectionSources.length > 0 && (
        <section class="related-sources" aria-labelledby="related-sources-title">
          <h2 id="related-sources-title">Coleções e fontes relacionadas</h2>
          <ResourceGrid resources={collectionSources} featuredPresentation />
        </section>
      )}
    </div>
  </section>
</BaseLayout>


<style>
  .related-sources { margin-top: 4rem; }
</style>
