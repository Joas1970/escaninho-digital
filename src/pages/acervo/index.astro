---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import NavCard from "../../components/NavCard.astro";
import ResourceGrid from "../../components/ResourceGrid.astro";
import { resources, hasResourceDestination, getSources } from "../../data/resources";

const available = resources.filter(r => r.kind !== "source" && hasResourceDestination(r));
const sources = getSources().filter(hasResourceDestination);
---
<BaseLayout title="Explorar o acervo" description="Explore atividades, jogos e materiais de apoio para enriquecer o ensino e a aprendizagem." path="/acervo/">
  <section class="section">
    <div class="container">
      <PageIntro eyebrow="Acervo" title="Explore o acervo" text="Uma seleção de atividades, jogos e materiais de apoio para enriquecer o ensino e a aprendizagem. Descubra possibilidades para sua prática." />
      <section aria-labelledby="collections-title">
        <h2 id="collections-title">Encontre seu próximo recurso</h2>
        <div class="collection-grid">
          <NavCard title="Atividades e jogos" description="Jogos educativos e ferramentas para criar, compartilhar e imprimir atividades." href="/acervo/atividades-e-jogos/" />
          <NavCard title="Materiais de apoio" description="Materiais de consulta e coleções de referência para apoiar o planejamento, o estudo e a prática docente." href="/acervo/materiais-de-apoio/" />
        </div>
      </section>
      {available.length > 0 && <section class="resource-section" aria-labelledby="resources-title">
        <h2 id="resources-title">Atividades e recursos disponíveis</h2>
        <ResourceGrid resources={available} featuredPresentation />
      </section>}
      {sources.length > 0 && <section class="resource-section" aria-labelledby="sources-title">
        <h2 id="sources-title">Coleções e fontes para explorar</h2>
        <ResourceGrid resources={sources} featuredPresentation />
      </section>}
    </div>
  </section>
</BaseLayout>
<style>
  h2 { font-size: clamp(1.5rem, 2.4vw, 1.875rem); margin-bottom: 2rem; }
  .collection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .resource-section { margin-top: 4rem; }
  @media (max-width: 640px) { .collection-grid { grid-template-columns: 1fr; } }
</style>
