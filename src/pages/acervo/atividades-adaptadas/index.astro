---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import ResourceGrid from "../../../components/ResourceGrid.astro";
import { getResourcesByCollection } from "../../../data/resources";

const collectionResources = getResourcesByCollection("atividades-adaptadas");
---

<BaseLayout
  title="Atividades adaptadas"
  description="Recursos e atividades pensados para diferentes ritmos e formas de aprender, organizados pelo Escaninho Digital."
  path="/acervo/atividades-adaptadas/"
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow="Acervo · Atividades adaptadas"
        title="Atividades adaptadas"
        text="Recursos pensados para diferentes ritmos, formas de aprender e necessidades específicas em sala de aula."
      />
      <section aria-labelledby="collection-resources-title">
        <h2 id="collection-resources-title">Recursos da coleção</h2>
        <ResourceGrid resources={collectionResources} />
        <p class="related-project">
          Conheça também o projeto{" "}
          <a href="https://www.montarparaaprender.com.br" target="_blank" rel="noopener noreferrer">
            Montar para Aprender<span aria-hidden="true"> ↗</span>
            <span class="sr-only"> (site externo, abre em nova aba)</span>
          </a>.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>


<style>
  .related-project { margin-top: 2rem; max-width: 56ch; color: var(--color-text-muted); }
  .related-project a { color: var(--color-text); text-underline-offset: 0.2em; }
</style>
