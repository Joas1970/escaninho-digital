---
import BaseLayout from "../../../layouts/BaseLayout.astro";
const activityUrl = "https://cruzadinha-escaninho.vercel.app/?modo=aluno";
const teacherUrl = "https://cruzadinha-escaninho.vercel.app/?modo=professor";
---
<BaseLayout title="Palavras cruzadas" description="Resolva cruzadinhas de História e Filosofia no modo aluno. Leia as dicas, preencha a grade e continue de onde parou." path="/atividades/cruzadinha/" image="/images/resources/cruzadinha.webp">
  <section class="crossword-page">
    <div class="container">
      <nav class="crossword-nav" aria-label="Navegação da atividade">
        <a href="/acervo/atividades-e-jogos/">← Atividades e jogos</a>
        <a id="crossword-open" href={activityUrl} target="_blank" rel="noopener noreferrer">Abrir em tela inteira ↗</a>
      </nav>
      <h1>Palavras cruzadas</h1>
      <aside class="teacher-callout" aria-labelledby="teacher-title">
        <div>
          <p class="teacher-eyebrow">Para professores</p>
          <h2 id="teacher-title">Crie e compartilhe com sua turma</h2>
          <p>Personalize as palavras e dicas, monte a grade e envie a atividade aos alunos. Não é preciso cadastro.</p>
          <ol class="teacher-steps">
            <li>Abra <strong>Conteúdo</strong> para criar ou editar a lista.</li>
            <li>Clique em <strong>Montar grade</strong>.</li>
            <li>Use <strong>Compartilhar atividade</strong> para enviar à turma.</li>
          </ol>
          <a class="teacher-action" href={teacherUrl} target="_blank" rel="noopener noreferrer">Criar e compartilhar atividade <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>
        </div>
        <div>
          <h3>Opções para sua aula</h3>
          <ul class="teacher-options">
            <li>Copiar o link da atividade</li>
            <li>Enviar pelo WhatsApp ou compartilhar pelo celular</li>
            <li>Baixar o QR code para slides ou impressão</li>
            <li>Apresentar o QR code para a turma</li>
            <li>Copiar o código para incorporar em uma página</li>
          </ul>
          <p class="teacher-note">Os links enviados abrem no modo aluno, sem Revelar, Gabarito ou editor.</p>
        </div>
      </aside>
      <p class="crossword-intro">História e Filosofia: escolha um tema, leia as dicas e complete a grade. A atividade abre no modo aluno, sem Revelar, Gabarito ou editor.</p>
      <p class="crossword-note">Seu progresso fica neste navegador. Se a atividade não aparecer ou o salvamento estiver bloqueado, use “Abrir em tela inteira”.</p>
    </div>
    <div class="crossword-frame-wrap">
      <iframe id="crossword-frame" data-cruzadinha-embed src={`${activityUrl}&incorporar=1`} title="Palavras cruzadas de História e Filosofia — modo aluno" width="100%" height="1400" allow="fullscreen" loading="eager"></iframe>
    </div>
    <noscript><p class="container">Ative o JavaScript para jogar ou <a href={activityUrl}>abra a atividade em outra aba</a>.</p></noscript>
  </section>
</BaseLayout>
<script>
  const frame = document.getElementById("crossword-frame") as HTMLIFrameElement | null;
  const openLink = document.getElementById("crossword-open") as HTMLAnchorElement | null;
  if (frame && openLink) {
    const target = new URL("https://cruzadinha-escaninho.vercel.app/");
    const incoming = new URL(window.location.href);
    // Preserve lesson links while always keeping the public page in student mode.
    target.searchParams.set("modo", "aluno");
    for (const key of ["tema", "conferir"]) {
      const value = incoming.searchParams.get(key);
      if (value !== null) target.searchParams.set(key, value);
    }
    if (incoming.hash.startsWith("#atividade=")) target.hash = incoming.hash;
    openLink.href = target.href;
    target.searchParams.set("incorporar", "1");
    if (frame.src !== target.href) frame.src = target.href;
    window.addEventListener("message", (event) => {
      if (event.origin !== target.origin || event.source !== frame.contentWindow || event.data?.type !== "escaninho:crossword:resize") return;
      const height = event.data.height;
      if (typeof height === "number" && Number.isFinite(height) && height >= 100 && height <= 16000) frame.style.height = `${Math.ceil(height) + 4}px`;
    });
  }
</script>
<style>
  .crossword-page { padding-block: 2rem 3rem; }
  .crossword-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .crossword-nav a { display: inline-flex; min-height: 44px; align-items: center; }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 0.75rem; }
  .crossword-intro { max-width: 75ch; }
  .crossword-note { color: var(--color-text-muted); font-size: 0.875rem; margin-block: 0.75rem 1.5rem; }
  .teacher-callout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2rem; padding: clamp(1.25rem, 3vw, 2rem); margin-block: 1.5rem 2rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg-muted); color: var(--color-text); }
  .teacher-eyebrow { color: var(--color-gold-text); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.5rem; }
  .teacher-callout h2 { font-size: clamp(1.25rem, 2.5vw, 1.6rem); margin-bottom: 0.75rem; }
  .teacher-callout h3 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .teacher-steps, .teacher-options { padding-left: 1.25rem; margin-block: 1rem; }
  .teacher-steps { list-style: decimal; }
  .teacher-options { list-style: disc; }
  .teacher-steps li, .teacher-options li { margin-block: 0.5rem; }
  .teacher-action { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0.75rem 1rem; gap: 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); color: var(--color-text); font-weight: 600; text-align: center; }
  .teacher-action:hover { color: var(--color-gold-text); }
  .teacher-note { font-size: 0.875rem; color: var(--color-text-muted); }
  @media (max-width: 640px) { .teacher-callout { grid-template-columns: minmax(0, 1fr); gap: 1rem; } .teacher-action { width: 100%; } }
  .crossword-frame-wrap { max-width: 1280px; margin-inline: auto; border-block: 1px solid var(--color-border); }
  iframe { display: block; border: 0; width: 100%; }
  @media print { .crossword-nav, .crossword-intro, .crossword-note, .teacher-callout { display: none; } }
</style>
