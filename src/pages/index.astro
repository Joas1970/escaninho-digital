---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import NavCard from "../components/NavCard.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getFeaturedProjects } from "../data/projects";

const featuredProjects = getFeaturedProjects();
---

<BaseLayout
  title="Início"
  description="O Escaninho Digital reúne recursos, experiências e materiais educacionais para apoiar professores e estudantes em diferentes caminhos de aprendizagem."
  path="/"
>
  <Hero
    eyebrow="Acervo · Educação · Humanidades"
    title="Um espaço para ensinar, aprender e compartilhar."
    text="O Escaninho Digital reúne recursos, experiências e materiais educacionais para apoiar professores e estudantes em diferentes caminhos de aprendizagem."
    image="/images/hero-escaninho.png"
    imageAlt="Mesa de trabalho com livros de História, Filosofia e Humanidades, um busto clássico, um globo terrestre e um notebook."
  />

  <section class="section home-section home-explore" aria-labelledby="explore-title">
    <div class="container">
      <div class="section-header">
        <h2 id="explore-title">Explore o Escaninho</h2>
        <p>Três caminhos para começar.</p>
      </div>
      <div class="card-grid">
        <NavCard
          title="Acervo"
          description="Materiais e referências de História, Filosofia e atividades adaptadas."
          href="/acervo/"
        >
          <Fragment slot="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v14" />
              <path d="M6.5 3v16a2 2 0 0 0 2 2h9.5" />
              <path d="M8 7h7" />
              <path d="M8 11h7" />
            </svg>
          </Fragment>
        </NavCard>

        <NavCard
          title="Espaço Docente"
          description="Reflexões, práticas e apoio para o trabalho cotidiano do professor."
          href="/espaco-docente/"
        >
          <Fragment slot="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="12" rx="1" />
              <path d="M8 20h8" />
              <path d="M12 16v4" />
              <path d="M7 9h10" />
            </svg>
          </Fragment>
        </NavCard>

        <NavCard
          title="Projetos"
          description="Iniciativas do ecossistema educacional, apresentadas e contextualizadas."
          href="/projetos/"
        >
          <Fragment slot="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1" />
              <rect x="14" y="3" width="7" height="7" rx="1" />
              <rect x="3" y="14" width="7" height="7" rx="1" />
              <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
          </Fragment>
        </NavCard>
      </div>
    </div>
  </section>

  <section class="section section--muted home-section" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-header">
        <h2 id="featured-title">Projetos em destaque</h2>
        <p>
          Uma seleção de iniciativas e experiências educacionais para conhecer,
          acompanhar e ampliar as possibilidades de ensinar e aprender.
        </p>
      </div>
      <ProjectGrid projects={featuredProjects} />
    </div>
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .home-section .section-header {
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .home-section h2 {
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .home-section .section-header p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .home-section :global(.card-grid) {
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .home-explore :global(.nav-card) {
    padding: clamp(1.5rem, 3vw, 2rem);
    gap: 0.75rem;
  }

  .home-explore :global(.nav-card__title) {
    font-size: 1.125rem;
  }

  .home-explore :global(.nav-card__description) {
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .home-explore :global(.card-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
