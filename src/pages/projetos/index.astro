---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageIntro from "../../components/PageIntro.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { projects } from "../../data/projects";
---

<BaseLayout
  title="Projetos"
  description="Projetos independentes do ecossistema educacional apresentados pelo Escaninho Digital."
  path="/projetos/"
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow="Projetos"
        title="Iniciativas do ecossistema educacional"
        text="O Escaninho apresenta iniciativas educacionais independentes, cada uma com seus próprios objetivos e ambientes. Aqui, você encontra uma apresentação de suas propostas e, quando disponível, o acesso ao projeto."
      />
      <section aria-labelledby="projetos-title">
        <h2 id="projetos-title">Projetos educacionais</h2>
        <ProjectGrid projects={projects} />
      </section>
    </div>
  </section>
</BaseLayout>
