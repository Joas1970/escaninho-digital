---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import { getProjectBySlug } from "../../../data/projects";

const project = getProjectBySlug("acervo-visual-de-humanidades");
if (!project) throw new Error("Projeto não encontrado: acervo-visual-de-humanidades");
---

<BaseLayout
  title={project.title}
  description={project.description}
  path="/projetos/acervo-visual-de-humanidades/"
  image={project.image}
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow={`Projeto · ${project.category}`}
        title={project.title}
        text={project.description}
      />
      <img
        src={project.image}
        alt={project.imageAlt}
        width="960"
        height="600"
        class="project-image"
      />
      <div class="content-block">
        <p>
          O Acervo Visual de Humanidades reúne imagens, mapas e materiais
          visuais que apoiam o ensino de História, Filosofia e Humanidades.
          É um projeto em formação dentro do ecossistema do Escaninho
          Digital — o conteúdo completo será publicado progressivamente.
        </p>
        <p>
          Quer colaborar com materiais ou sugerir fontes? Entre em contato
          pela página de <a href="/contato/">Contato</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-image {
    width: 100%;
    max-width: 48rem;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: var(--space-lg);
  }
</style>
