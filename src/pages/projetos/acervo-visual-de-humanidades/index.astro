---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/PageIntro.astro";
import { getProjectBySlug } from "../../../data/projects";

const project = getProjectBySlug("acervo-visual-de-humanidades");
if (!project) throw new Error("Projeto não encontrado: acervo-visual-de-humanidades");
---

<BaseLayout
  title={project.title}
  description={project.description}
  path="/projetos/acervo-visual-de-humanidades/"
  image={project.image}
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow={`Projeto · ${project.category}`}
        title={project.title}
        text={project.description}
      />
      <img
        src={project.image}
        alt={project.imageAlt}
        width="960"
        height="600"
        class="project-image"
      />
      <div class="content-block">
        <p>
          O Acervo Visual de Humanidades, também apresentado como Humanidades
          em Foco — Acervo Visual Educacional, é uma iniciativa disponível
          para acesso público, dedicada à curadoria de imagens, mapas e
          materiais visuais para pesquisa e exploração de História,
          Filosofia e Humanidades.
        </p>
        <p>
          <a href={project.url} target="_blank" rel="noopener noreferrer">
            Acesse o Acervo Visual de Humanidades
            <span class="sr-only"> (site externo, abre em uma nova aba)</span>
          </a>
        </p>
        <p>
          Quer colaborar com materiais ou sugerir fontes? Entre em contato
          pela página de <a href="/contato/">Contato</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-image {
    width: 100%;
    max-width: 48rem;
    height: auto;
    border-radius: var(--radius);
    margin-bottom: var(--space-lg);
  }
</style>
