---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";

// Copie a imagem para este caminho e execute o build novamente ao publicar.
const imagePath = "/images/espaco-docente/espaco-docente.png";
---

<BaseLayout
  title="Espaço Docente"
  description="Reflexões, práticas e apoio para o trabalho cotidiano do professor, no Escaninho Digital."
  path="/espaco-docente/"
>
  <section class="section">
    <div class="container">
      <PageIntro
        eyebrow="Espaço Docente"
        title="Espaço Docente"
        text="Um espaço voltado à prática e à reflexão docente: planejamento, metodologias, formação continuada e trocas entre professores."
      />
      <div class="docente-image">
        <img src={imagePath} alt="" width="1600" height="800" />
      </div>
      <section class="content-block docente-editorial" aria-labelledby="pratica-title">
        <h2 id="pratica-title">Um espaço para pensar a prática</h2>
        <p>
          O Espaço Docente reúne reflexões, experiências e referências relacionadas
          ao cotidiano de ensinar. Mais do que oferecer materiais prontos, a
          proposta é compartilhar caminhos, metodologias e ideias que possam
          contribuir para o planejamento e para a prática pedagógica.
        </p>
      </section>
      <section class="docente-eixos" aria-labelledby="crossword-teacher-title">
        <h2 id="crossword-teacher-title">Crie e compartilhe palavras cruzadas</h2>
        <p>Prepare uma atividade com suas palavras e dicas e compartilhe com os alunos por link, WhatsApp ou QR code. A área do professor também permite imprimir e apresentar a atividade para a turma.</p>
        <a class="docente-tool-link" href="https://cruzadinha-escaninho.vercel.app/?modo=professor" target="_blank" rel="noopener noreferrer">Criar e compartilhar atividade <span aria-hidden="true">↗</span><span class="sr-only"> (abre em nova aba)</span></a>
      </section>
      <section class="docente-eixos" aria-labelledby="eixos-title">
        <h2 id="eixos-title">Eixos editoriais</h2>
        <div class="docente-eixos__grid">
          <div>
            <h3>Prática docente</h3>
            <p>Experiências, planejamento e reflexões surgidas do cotidiano escolar.</p>
          </div>
          <div>
            <h3>Metodologias e inclusão</h3>
            <p>Adaptações, estratégias de participação e possibilidades de aprendizagem.</p>
          </div>
          <div>
            <h3>Tecnologia e educação</h3>
            <p>Uso pedagógico de ferramentas digitais, inteligência artificial e recursos interativos.</p>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .docente-image {
    margin-bottom: var(--space-lg);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .docente-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    /* Ajuste o enquadramento aqui após inserir a imagem definitiva. */
    object-position: center;
  }

  .docente-editorial h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
  }

  .docente-editorial p {
    margin-bottom: 0;
  }

  .docente-eixos {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .docente-eixos h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin-bottom: var(--space-md);
  }
  .docente-tool-link { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; margin-top: 0.75rem; font-weight: 600; }

  .docente-eixos__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .docente-eixos__grid h3 {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .docente-eixos__grid p {
    margin-bottom: 0;
  }

  @media (min-width: 1001px) {
    .docente-eixos__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .docente-eixos {
      margin-top: var(--space-md);
    }

    .docente-image {
      margin-bottom: var(--space-md);
    }

    .docente-image img {
      aspect-ratio: 4 / 3;
    }
  }
</style>

